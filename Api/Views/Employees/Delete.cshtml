@model Api.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="row">
    <div class="col-md-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Delete Employee</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Warning!</strong> Are you sure you want to delete this employee? This action cannot be undone.
                </div>
                
                <dl class="row">
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.FullName)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.FullName)
                    </dd>
                    
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Email)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Email)
                    </dd>
                    
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Position)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Position)
                    </dd>
                    
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Department)
                    </dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-secondary">@Html.DisplayFor(model => model.Department)</span>
                    </dd>
                    
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.HireDate)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.HireDate)
                    </dd>
                </dl>
            </div>
            <div class="card-footer">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="EmployeeId" />
                    <button type="submit" class="btn btn-danger me-2">
                        <i class="fas fa-trash"></i> Delete Employee
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
