@model Api.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">Employee Details</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.FullName)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.FullName)
                    </dd>
                    
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Email)
                    </dt>
                    <dd class="col-sm-9">
                        <a href="mailto:@Model?.Email">@Html.DisplayFor(model => model.Email)</a>
                    </dd>
                    
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Position)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Position)
                    </dd>
                    
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Department)
                    </dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-secondary">@Html.DisplayFor(model => model.Department)</span>
                    </dd>
                    
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Phone)
                    </dt>
                    <dd class="col-sm-9">
                        <a href="tel:@Model?.Phone">@Html.DisplayFor(model => model.Phone)</a>
                    </dd>
                    
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.HireDate)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.HireDate)
                    </dd>
                    
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.UpdatedBy)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.UpdatedBy)
                    </dd>
                    
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Updated)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Updated)
                    </dd>
                </dl>
            </div>
            <div class="card-footer">
                <a asp-action="Edit" asp-route-id="@Model?.EmployeeId" class="btn btn-primary me-2">
                    <i class="fas fa-edit"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>
